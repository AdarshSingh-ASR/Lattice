DATABASE_URL=postgresql://lattice_app:replace-me@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://lattice_migrator:replace-me@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EVIDENCE_BUCKET=
ALLOWED_ORIGIN=http://localhost:3000

# Optional local-only embedding fallback. Production uses Bedrock.
LATTICE_EMBED_PROVIDER=gemini
GEMINI_API_KEY=

# Keep unset in production. Useful when developing without Bedrock credentials.
LATTICE_PLANNER_PROVIDER=deterministic
